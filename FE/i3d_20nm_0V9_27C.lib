  /******************************************************************************************
   Module          	: TBUF_X1
   Cell Description	: Combinational tri-state cell (TBUF_X1) with drive strength X1
  *******************************************************************************************/

  cell(AND2_X1) { 
    area : 0.042 ; 
    cell_leakage_power : 416.2 ; 

    leakage_power() { 
      when : "A1&A2" ; 
      value : "902.3" ; 
    }

    leakage_power() { 
      when : "!A1&!A2" ; 
      value : "416.2" ; 
    }

    leakage_power() { 
      when : "A1&!A2" ; 
      value : "640.8" ; 
    }

    leakage_power() { 
      when : "!A1&A2" ; 
      value : "650.3" ; 
    }
    rail_connection(VDD, RAIL_VDD);
    rail_connection(VSS, RAIL_VSS);

    pin(A1) { 
      direction : input ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 1.186 ; 
      fall_capacitance_range(0.7166, 1.186);
      input_signal_level : RAIL_VDD ; 
      capacitance : 1.186 ; 
      max_transition : 0.6 ; 
      rise_capacitance : 1.178 ; 
      rise_capacitance_range(0.7134, 1.178);

      internal_power() { 

        rise_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("-0.3429, -0.3428, -0.3427, -0.3428, -0.3429, -0.343, -0.3431");
        }

        fall_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("0.4112, 0.4112, 0.4111, 0.4111, 0.4113, 0.4112, 0.4113");
        }
      }
    }

    pin(A2) { 
      direction : input ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 1.144 ; 
      fall_capacitance_range(0.8026, 1.144);
      input_signal_level : RAIL_VDD ; 
      capacitance : 1.161 ; 
      max_transition : 0.6 ; 
      rise_capacitance : 1.161 ; 
      rise_capacitance_range(0.814, 1.161);

      internal_power() { 

        rise_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("-0.3001, -0.3002, -0.3002, -0.3001, -0.3001, -0.3001, -0.3001");
        }

        fall_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("0.3376, 0.3341, 0.3322, 0.3308, 0.3297, 0.3286, 0.3276");
        }
      }
    }

