      capacitance : 0 ; 
      rise_capacitance : 0 ; 
      fall_capacitance : 0 ; 
      rise_capacitance_range(0, 0);
      fall_capacitance_range(0, 0);
      max_capacitance : 17.92 ; 
      max_transition : 0.3261 ; 
      function : "(A1 A2)" ; 

      timing() { 
        related_pin : "A1" ; 
        timing_sense : positive_unate ; 

